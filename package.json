{
  "name": "sip-discovery-engine",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "db:preflight": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/scripts/preflight-database.ts",
    "corpus:verify": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/scripts/verify-corpus.ts",
    "reviews:normalize": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/scripts/normalize-store-reviews.ts",
    "reviews:validate": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/scripts/validate-review-csv.ts"
  },
  "dependencies": {
    "next": "16.4.3",
    "papaparse": "^5.7.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.12"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
